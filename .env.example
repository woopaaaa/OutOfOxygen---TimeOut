# Copy this file to .env and paste ONE free key. .env is git-ignored, never commit it.
# Without a key the engine still works and uses built-in plain-English explanations.

# Groq (free tier, fast): https://console.groq.com/keys
GROQ_API_KEY=

# or Google Gemini (free tier): https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# or OpenRouter free models: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Optional: change the model if the default one is retired
# LLM_MODEL=llama-3.3-70b-versatile
